{
  "name": "express-starter",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env PLATFORM=development DEBUG=* node --inspect --watch --watch-path=server --import tsx server/index.ts | pino-pretty",
    "start": "cross-env NODE_ENV=production PLATFORM=production node --enable-source-maps ./dist/index.js",
    "build": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\" && tsc --incremental false && node -e \"require('fs').cpSync('server/views', 'dist/views', {recursive: true})\"",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write server/",
    "format:check": "prettier --check server/"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
